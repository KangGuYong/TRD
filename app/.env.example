# 복사해서 app/.env 로 두고 값을 채운다: cp .env.example .env
#
# 백엔드 접속 주소.
# - iOS 시뮬레이터: http://localhost:8080
# - Android 에뮬레이터: http://10.0.2.2:8080
# - 실기기(Expo Go, 같은 Wi-Fi): http://<개발PC의 LAN IP>:8080  예) http://192.168.0.56:8080
#   (개발 PC IP 확인: Windows `ipconfig` → 무선 LAN 어댑터 IPv4 주소)
EXPO_PUBLIC_API_URL=http://localhost:8080
