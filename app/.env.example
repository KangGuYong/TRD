# 복사해서 app/.env 로 두고 값을 채운다: cp .env.example .env
#
# 백엔드 접속 주소.
# - iOS 시뮬레이터: http://localhost:8080
# - Android 에뮬레이터: http://10.0.2.2:8080
# - 실기기(dev client, 같은 Wi-Fi): http://<개발PC의 LAN IP>:8080  예) http://192.168.0.56:8080
#   (개발 PC IP 확인: Windows `ipconfig` → 무선 LAN 어댑터 IPv4 주소)
EXPO_PUBLIC_API_URL=http://localhost:8080

# Firebase 콘솔 → 프로젝트 설정 → "웹 앱"의 클라이언트 ID (…apps.googleusercontent.com).
# 안드로이드/iOS 클라이언트 ID가 아니라 반드시 "웹" 클라이언트 ID여야 한다 —
# expo-auth-session이 Expo Go 프록시(auth.expo.io)로 리다이렉트할 때 이 값을 쓴다.
# Google Cloud Console → 이 클라이언트의 "승인된 리디렉션 URI"에
# https://auth.expo.io/@<expo계정>/<app.json의 slug> 를 등록해야 한다.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Firebase 콘솔 → 프로젝트 설정 → "일반" 탭에 값이 있다("웹 앱"이 없다면 하나 추가).
# 앱이 네이티브 Firebase SDK 없이 Firebase JS SDK(웹 방식)로 붙기 때문에 필요하다.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
