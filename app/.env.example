# 복사해서 app/.env 로 두고 값을 채운다: cp .env.example .env
#
# 백엔드 접속 주소.
# - iOS 시뮬레이터: http://localhost:8080
# - Android 에뮬레이터: http://10.0.2.2:8080
# - 실기기(dev client, 같은 Wi-Fi): http://<개발PC의 LAN IP>:8080  예) http://192.168.0.56:8080
#   (개발 PC IP 확인: Windows `ipconfig` → 무선 LAN 어댑터 IPv4 주소)
EXPO_PUBLIC_API_URL=http://localhost:8080

# Firebase 콘솔 → 프로젝트 설정 → "웹 앱"의 클라이언트 ID (…apps.googleusercontent.com).
# 안드로이드/iOS 클라이언트 ID가 아니라 반드시 "웹" 클라이언트 ID여야 한다 —
# GoogleSignin이 이 값으로 Firebase에 넘길 idToken을 발급받는다.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
