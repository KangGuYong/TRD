  },
  "dependencies": {
    "expo": "~52.0.0",
    "expo-font": "~13.0.0",
    "expo-notifications": "~0.29.0",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/bottom-tabs": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "@tanstack/react-query": "^5.59.0",
    "react-native-svg": "15.8.0"
  },
  "devDependencies": {
    "@types/react": "~18.3.0",
    "typescript": "~5.6.0",
    "openapi-typescript": "^7.4.0"
  }
}
