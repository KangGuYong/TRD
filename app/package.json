{
  "name": "trend-radar-app",
  "version": "0.1.0",
  "private": true,
  "description": "유행수명 앱 (React Native · Expo). 하루 5개, 끝이 있는 트렌드 판정.",
  "main": "index.ts",
  "scripts": {
