# Trend Radar — docker compose 설정. 복사해서 infra/.env 로 쓴다(.env 는 gitignore 대상):
#   cp .env.example .env
# 값에 $ 가 들어가면 $$ 로 적는다(compose 변수 치환 문법).

# ── DB ────────────────────────────────────────────────────────────────
# 볼륨을 처음 만들 때만 적용된다. 이미 만든 볼륨의 비밀번호를 바꾸는 법은 README "접속 오류 대처".
DB_PASSWORD=change-me

# ── 최초 관리자 계정 ─────────────────────────────────────────────────────
# admin_accounts가 비어 있을 때 한 번만 만든다. 첫 로그인 뒤에는 지워도 된다(다시 기동해도 무시된다).
ADMIN_BOOTSTRAP_LOGIN_ID=admin
ADMIN_BOOTSTRAP_PASSWORD=

# ── Firebase (앱 API /v1 인증) ───────────────────────────────────────────
# 서비스 계정 키를 infra/secrets/firebase-adminsdk.json 으로 두고 주석을 푼다.
# 비워 두면 앱은 뜨고, 인증이 필요한 /v1 요청만 401이다(관리자 콘솔은 영향 없음).
# FIREBASE_CREDENTIALS_PATH=/run/secrets/trd/firebase-adminsdk.json

# ── 호스트에 공개할 포트 ([IP:]포트) ─────────────────────────────────────
# 127.0.0.1: 을 붙이면 이 PC 안에서만 접속된다. 서버에 올릴 때 DB·임베딩은 바깥에 열지 않는다.
# 다른 PC가 이 DB에 붙어 개발한다면 DB_PUBLISH=5433 처럼 IP 없이 적는다.
DB_PUBLISH=127.0.0.1:5433
EMBEDDINGS_PUBLISH=127.0.0.1:6000
BACKEND_PUBLISH=8080
ADMIN_PUBLISH=8081

# ── 제보 기기·IP 해시(SP4) ───────────────────────────────────────────────
# 필수 — 비어 있으면 백엔드 컨테이너가 기동을 거부한다(SignalHasher fail-fast). 기기 ID·IP 원문은 저장하지
# 않고 이 값으로 만든 HMAC만 저장한다. 한 번 정하면 바꾸지 않는다 — 바꾸면 이전 제보와 같은 기기·IP로 묶이지
# 않는다. 만들기: openssl rand -hex 32
SIGNAL_HASH_SECRET=
# 백엔드를 리버스 프록시 뒤에 둘 때만 native로 바꾼다(프록시가 X-Forwarded-For를 덮어써야 한다).
# SERVER_FORWARD_HEADERS_STRATEGY=native

# ── 배치 스케줄 ─────────────────────────────────────────────────────────
# cluster_merge 02:00 KST, verdict_runner 03:00 KST, grade_recalc 월 00:00 KST — 모두 코드 기본값.
# grade_recalc는 코드에 KST가 명시돼 있어 보정이 필요 없다.
# sla_watch 매시 정각(코드·docker-compose 기본 "0 0 * * * *", 초 분 시 일 월 요일). 바꾸려면 아래 주석을 풀어 고친다 —
# docker-compose가 backend 컨테이너에 JOBS_SLA_WATCH_CRON으로 넘기고, 스프링이 jobs.sla-watch.cron으로 읽는다.
# JOBS_SLA_WATCH_CRON="0 0 * * * *"
