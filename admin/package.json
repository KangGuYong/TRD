{
  "name": "trend-radar-admin",
  "version": "0.1.0",
  "private": true,
  "description": "트렌드 관리자 콘솔 (React + Vite). 큐 중심 · 데스크톱 전용.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "gen:api": "openapi-typescript ../backend/api-spec/openapi.yaml -o src/api/schema.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-table": "^8.20.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "~5.6.0",
    "vite": "^5.4.0",
    "openapi-typescript": "^7.4.0"
  }
}
